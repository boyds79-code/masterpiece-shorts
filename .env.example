# Claude API (script writing, vision analysis of the painting)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Gemini API (text-to-speech narration)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore

# YouTube Data API v3 (OAuth client + refresh token, see README "YouTube 설정")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Upload visibility while you're reviewing new videos: private | unlisted
YOUTUBE_PRIVACY_STATUS=private
